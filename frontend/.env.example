# Frontend environment (no secrets belong here - everything in VITE_* is public in the browser bundle)

# Base URL of the backend API when the frontend is served from a different origin.
# Leave empty when the API is served on the same origin (recommended: reverse proxy /api).
VITE_API_BASE_URL=

# Dev server only: where `npm run dev` proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:8080
