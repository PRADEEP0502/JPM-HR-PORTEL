# JPM HRMS backend environment - copy to .env (never commit real values).
# The backend reads these as environment variables.

# --- Profile -------------------------------------------------------------
# "dev"  = local development: MongoDB on this machine (or EMBEDDED_MONGO=true), dev-only defaults
# unset  = production settings (set MONGODB_URI and JWT_SECRET; no demo data)
SPRING_PROFILES_ACTIVE=

# --- Server --------------------------------------------------------------
SERVER_PORT=8080
APP_TIMEZONE=Asia/Kolkata
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where uploaded documents are stored (must be persistent, NOT web-served)
UPLOAD_DIR=./data/uploads
# local = private folder UPLOAD_DIR; gridfs = inside MongoDB GridFS (no server disk; included in mongodump backups)
FILE_STORAGE=local
# Accepted upload types (the file content must also match the extension) and size limit
UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=11MB
# Malware scanning: off (development) or clamav (free ClamAV daemon, e.g. the clamav/clamav Docker image)
MALWARE_SCAN_MODE=off
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# true = reject uploads while the scanner is unreachable (recommended in production)
MALWARE_SCAN_FAIL_CLOSED=true
# Base64-encoded 32-byte AES key; documents are encrypted at rest. REQUIRED for Aadhaar uploads.
# Generate once:  openssl rand -base64 32   (keep it safe - losing it makes stored files unreadable)
DOCUMENT_ENCRYPTION_KEY=

# --- Database (MongoDB 6+) -----------------------------------------------
# MongoDB Atlas (free M0 cluster for development; see README for its limits):
#   MONGODB_URI=mongodb+srv://jpm_hrms_app:<password>@<cluster-host>/jpm_hrms?retryWrites=true&w=majority
# Self-hosted / local MongoDB:
#   MONGODB_URI=mongodb://localhost:27017/jpm_hrms
# The database name is the path in the URI. Use an app user with readWrite on that database only.
MONGODB_URI=mongodb://localhost:27017/jpm_hrms
# dev profile only: true = start a development-only MongoDB inside the app (data in ./data/mongo)
EMBEDDED_MONGO=false

# --- One-time import from the previous SQL database (leave empty normally) --------
# e.g. LEGACY_JDBC_URL=jdbc:h2:file:./data/hrms-dev-pg;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;ACCESS_MODE_DATA=r
#      LEGACY_JDBC_URL=jdbc:postgresql://localhost:5432/jpm_hrms
LEGACY_JDBC_URL=
LEGACY_JDBC_USERNAME=
LEGACY_JDBC_PASSWORD=

# --- Security --------------------------------------------------------------
# At least 32 random characters, e.g.  openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=480
# Sign-in requests allowed per client IP in 5 minutes (in addition to the per-username lockout)
LOGIN_ATTEMPTS_PER_IP=20
# First administrator, created only when the users table is empty.
# Remove these after first sign-in and change the password in the app.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Demo mode -------------------------------------------------------------
# true seeds clearly-labelled sample candidates into an EMPTY database.
DEMO_MODE=false

# --- Email (SMTP) - used for interview invitation emails -------------------
# Any approved SMTP provider: Gmail / Google Workspace (smtp.gmail.com:587 + app password),
# Microsoft 365 (smtp.office365.com:587), Amazon SES, SendGrid, ... Leave MAIL_HOST empty to
# disable sending (previews still work). Credentials stay on the server only.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Sender address/name candidates see (must be allowed by the provider)
MAIL_FROM=
MAIL_FROM_NAME=JPM HR Department

# --- Google Forms / Sheets integration ------------------------------------
# Absolute path to the service-account JSON key file on the server.
# Keep this file outside the repository and readable only by the app user.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Defaults; an administrator can change them in Settings -> Google Sheets integration.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Form Responses 1
GOOGLE_FORM_URL=
